# ============================================================================
# amitOS — Package List
# ============================================================================
# APT packages to install in the amitOS image and via install.sh.
# Lines starting with # are comments. Empty lines are ignored.
# ============================================================================

# --- Core System ---
apt-transport-https
ca-certificates
curl
wget
gnupg
lsb-release
software-properties-common
sudo
openssh-server
systemd-timesyncd
cron
logrotate
htop
iotop
tmux
vim-tiny
less
jq
tree
unzip
rsync
git

# --- Networking ---
netplan.io
nginx
nftables
iproute2
iputils-ping
dnsutils
net-tools
bridge-utils
vlan
ethtool
tcpdump
iperf3

# --- Python (Adapter Framework & AI) ---
python3
python3-pip
python3-venv
python3-dev
python3-setuptools
python3-yaml

# --- Industrial Protocol Dependencies ---
# open62541 (OPC UA) build dependencies
libmbedtls-dev
libxml2-dev
cmake
build-essential

# --- Container Runtime ---
# Docker is installed via docker.com repo (not from Debian)
# Packages listed here are just dependencies
iptables
containerd

# --- Monitoring & Diagnostics ---
lm-sensors
smartmontools
sysstat

# --- Security ---
apparmor
apparmor-utils
apparmor-profiles
fail2ban
ufw
auditd

# --- Kernel Build Tools (optional — only for custom kernel builds) ---
# Uncomment if building kernels on the target:
# fakeroot
# dpkg-dev
# libncurses-dev
# flex
# bison
# libssl-dev
# libelf-dev
# bc
# dwarves
# cpio
