# ============================================================================
# amitOS Kernel Configuration Fragment
# ============================================================================
# This is NOT a full .config — it is a FRAGMENT applied on top of the
# Debian default kernel config using scripts/kconfig/merge_config.sh.
# Only options that differ from Debian defaults are listed here.
#
# Target: Debian Bookworm kernel (6.1.x LTS)
# Use-case: Industrial automation, edge computing, AI/GPU workloads
# Architecture: amd64 / arm64
# ============================================================================

# ----------------------------------------------------------------------------
# 1. PREEMPTION MODEL — Soft Real-Time
# ----------------------------------------------------------------------------
# Use voluntary preemption for low-latency industrial workloads.
# This is sufficient for OPC UA polling at 500ms–1s intervals.
# If sub-1ms hard real-time is required, switch to PREEMPT_RT.
CONFIG_PREEMPT=y
# CONFIG_PREEMPT_NONE is not set
# CONFIG_PREEMPT_VOLUNTARY is not set
CONFIG_PREEMPT_COUNT=y
CONFIG_PREEMPTION=y

# ----------------------------------------------------------------------------
# 2. HIGH-RESOLUTION TIMERS & SCHEDULING
# ----------------------------------------------------------------------------
CONFIG_HIGH_RES_TIMERS=y
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_NO_HZ_IDLE=y
CONFIG_NO_HZ_COMMON=y
CONFIG_SCHED_HRTICK=y
CONFIG_LATENCYTOP=y
CONFIG_SCHEDSTATS=y

# ----------------------------------------------------------------------------
# 3. CGROUPS — Required for Docker / Containers
# ----------------------------------------------------------------------------
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_RDMA=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CPUSETS=y

# ----------------------------------------------------------------------------
# 4. NAMESPACES — Required for Docker / Containers
# ----------------------------------------------------------------------------
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y

# ----------------------------------------------------------------------------
# 5. OVERLAYFS — Required for Docker image layers
# ----------------------------------------------------------------------------
CONFIG_OVERLAY_FS=y
CONFIG_OVERLAY_FS_REDIRECT_DIR=y
CONFIG_OVERLAY_FS_INDEX=y

# ----------------------------------------------------------------------------
# 6. NETWORKING — Industrial + Container networking
# ----------------------------------------------------------------------------
# Bridge and VXLAN for Docker networking
CONFIG_BRIDGE=m
CONFIG_VXLAN=m
CONFIG_VETH=m
CONFIG_MACVLAN=m
CONFIG_IPVLAN=m
CONFIG_DUMMY=m

# CAN Bus — Industrial fieldbus protocol
CONFIG_CAN=m
CONFIG_CAN_RAW=m
CONFIG_CAN_BCM=m
CONFIG_CAN_GW=m
CONFIG_CAN_VCAN=m
CONFIG_CAN_SLCAN=m
CONFIG_CAN_DEV=m
CONFIG_CAN_CALC_BITTIMING=y
CONFIG_CAN_MCP251X=m
CONFIG_CAN_MCP251XFD=m
CONFIG_CAN_PEAK_PCI=m
CONFIG_CAN_PEAK_USB=m
CONFIG_CAN_KVASER_USB=m
CONFIG_CAN_EMS_USB=m
CONFIG_CAN_GS_USB=m
CONFIG_CAN_SOFTING=m

# VLAN support
CONFIG_VLAN_8021Q=m
CONFIG_VLAN_8021Q_GVRP=y

# TCP/IP optimizations
CONFIG_TCP_CONG_BBR=m
CONFIG_NET_SCH_FQ=m
CONFIG_NET_SCH_FQ_CODEL=m

# nftables — Modern firewall (DAR decision #9)
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NFT_CT=m
CONFIG_NFT_COUNTER=m
CONFIG_NFT_LOG=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REDIR=m
CONFIG_NFT_NAT=m
CONFIG_NFT_REJECT=m
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_ARP=y
CONFIG_NF_TABLES_BRIDGE=m

# ----------------------------------------------------------------------------
# 7. INDUSTRIAL I/O (IIO) — Sensor subsystem for edge devices
# ----------------------------------------------------------------------------
CONFIG_IIO=m
CONFIG_IIO_BUFFER=y
CONFIG_IIO_BUFFER_CB=m
CONFIG_IIO_KFIFO_BUF=m
CONFIG_IIO_TRIGGERED_BUFFER=m
CONFIG_IIO_TRIGGER=y

# ADC drivers (common in industrial)
CONFIG_MAX1363=m
CONFIG_TI_ADS1015=m
CONFIG_TI_ADS7846=m

# Temperature sensors
CONFIG_MLX90614=m
CONFIG_TMP006=m

# Pressure sensors
CONFIG_BMP280=m
CONFIG_MS5611=m

# IMU / Accelerometers
CONFIG_BMI160=m
CONFIG_MPU3050=m
CONFIG_ADXL345_I2C=m
CONFIG_ADXL345_SPI=m

# ----------------------------------------------------------------------------
# 8. SERIAL / USB-SERIAL — Edge device communication
# ----------------------------------------------------------------------------
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_GENERIC=y
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_PL2303=m
CONFIG_USB_SERIAL_CP210X=m
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_OPTION=m

# RS-485 support
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_NR_UARTS=32
CONFIG_SERIAL_8250_RUNTIME_UARTS=4
CONFIG_SERIAL_8250_RSA=y

# ----------------------------------------------------------------------------
# 9. SPI / I2C / GPIO — Hardware interface buses
# ----------------------------------------------------------------------------
CONFIG_SPI=y
CONFIG_SPI_SPIDEV=m

CONFIG_I2C=y
CONFIG_I2C_CHARDEV=m
CONFIG_I2C_MUX=m

CONFIG_GPIOLIB=y
CONFIG_GPIO_SYSFS=y
CONFIG_GPIO_CDEV=y
CONFIG_GPIO_CDEV_V1=y

# ----------------------------------------------------------------------------
# 10. WATCHDOG — Industrial reliability
# ----------------------------------------------------------------------------
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_WATCHDOG_NOWAYOUT=y
CONFIG_SOFT_WATCHDOG=m
CONFIG_iTCO_WDT=m

# ----------------------------------------------------------------------------
# 11. GPU / DRM — NVIDIA driver support (out-of-tree)
# ----------------------------------------------------------------------------
# NVIDIA proprietary drivers are out-of-tree modules.
# We enable the infrastructure they need.
CONFIG_DRM=m
CONFIG_DRM_KMS_HELPER=m
CONFIG_FB=y
CONFIG_FB_VESA=y
CONFIG_FB_EFI=y

# Enable kernel module signing support (required for secure boot + NVIDIA)
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA256=y

# IOMMU for GPU passthrough in containers
CONFIG_IOMMU_SUPPORT=y
CONFIG_INTEL_IOMMU=y
CONFIG_AMD_IOMMU=y
CONFIG_VFIO=m
CONFIG_VFIO_PCI=m

# Huge pages for GPU memory management
CONFIG_HUGETLBFS=y
CONFIG_HUGETLB_PAGE=y
CONFIG_TRANSPARENT_HUGEPAGE=y

# ----------------------------------------------------------------------------
# 12. SECURITY — Hardened industrial OS
# ----------------------------------------------------------------------------
CONFIG_SECURITY=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
CONFIG_SECURITY_YAMA=y
CONFIG_AUDIT=y

# Stack protector
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y

# Address space layout randomization
CONFIG_RANDOMIZE_BASE=y

# Hardened usercopy
CONFIG_HARDENED_USERCOPY=y

# ----------------------------------------------------------------------------
# 13. DISABLE UNNECESSARY SUBSYSTEMS — Minimize attack surface
# ----------------------------------------------------------------------------
# Sound (not needed on headless industrial edge)
# CONFIG_SOUND is not set

# Bluetooth (not needed for industrial edge)
# CONFIG_BT is not set

# NFC (not needed)
# CONFIG_NFC is not set

# Joystick / Gamepad
# CONFIG_INPUT_JOYSTICK is not set
# CONFIG_INPUT_JOYDEV is not set

# DVB / TV tuner
# CONFIG_MEDIA_DIGITAL_TV_SUPPORT is not set
# CONFIG_MEDIA_ANALOG_TV_SUPPORT is not set
# CONFIG_MEDIA_RADIO_SUPPORT is not set

# Amateur Radio
# CONFIG_HAMRADIO is not set

# Infiniband (not used in edge)
# CONFIG_INFINIBAND is not set

# ----------------------------------------------------------------------------
# 14. POWER MANAGEMENT — Edge device efficiency
# ----------------------------------------------------------------------------
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y

# Intel P-State
CONFIG_X86_INTEL_PSTATE=y

# Thermal management
CONFIG_THERMAL=y
CONFIG_THERMAL_HWMON=y

# ----------------------------------------------------------------------------
# 15. MISC — Useful for industrial deployments
# ----------------------------------------------------------------------------
# NBD — Network Block Device (for remote imaging)
CONFIG_BLK_DEV_NBD=m

# dm-crypt for encrypted storage
CONFIG_DM_CRYPT=m

# FUSE for user-space filesystems
CONFIG_FUSE_FS=m

# Kernel crash dumps
CONFIG_KEXEC=y
CONFIG_CRASH_DUMP=y

# BPF for advanced tracing
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y

# PSI — Pressure Stall Information (resource monitoring)
CONFIG_PSI=y
CONFIG_PSI_DEFAULT_DISABLED=n

# ----------------------------------------------------------------------------
# 16. COMPREHENSIVE FILESYSTEM SUPPORT
# ----------------------------------------------------------------------------
CONFIG_BTRFS_FS=m
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_XFS_FS=m
CONFIG_XFS_QUOTA=y
CONFIG_XFS_POSIX_ACL=y
CONFIG_NTFS3_FS=m
CONFIG_NTFS3_LZX_XPRESS=y
CONFIG_NTFS3_FS_POSIX_ACL=y
CONFIG_EXFAT_FS=m
CONFIG_VFAT_FS=m
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_F2FS_FS=m
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
