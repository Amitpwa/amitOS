#!/usr/bin/env bash
# ============================================================================
# amitOS — Message of the Day (MOTD)
# ============================================================================
# Install to: /etc/update-motd.d/10-amitos
# Makes the amitOS banner appear every time a user logs in via SSH or console.
# ============================================================================

# Colors
CYAN='\033[0;36m'
WHITE='\033[1;37m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
DIM='\033[2m'
BOLD='\033[1m'
NC='\033[0m'

# Banner
echo -e "${CYAN}"
cat << 'LOGO'
        ╭──────────────────────────╮
        │  ██                      │
        │ ████       ╭──────╮     │
        │ ████       │ ╭──╮ │     │
        │  ██        │ ╰──╯ │     │
        │            ╰──────╯     │
        ╰──────────────────────────╯
LOGO
echo -e "${WHITE}${BOLD}"
cat << 'TEXT'
       ██████╗ ███╗   ███╗██╗████████╗ ██████╗ ███████╗
      ██╔══██╗████╗ ████║██║╚══██╔══╝██╔═══██╗██╔════╝
      ███████║██╔████╔██║██║   ██║   ██║   ██║███████╗
      ██╔══██║██║╚██╔╝██║██║   ██║   ██║   ██║╚════██║
      ██║  ██║██║ ╚═╝ ██║██║   ██║   ╚██████╔╝███████║
      ╚═╝  ╚═╝╚═╝     ╚═╝╚═╝   ╚═╝    ╚═════╝ ╚══════╝
TEXT
echo -e "${NC}"
echo -e "${DIM}  Industrial Automation OS │ Edge AI │ GPU-Powered${NC}"
echo -e "${DIM}  ─────────────────────────────────────────────────${NC}"
echo ""

# System info
VERSION="$(cat /etc/amitos/version 2>/dev/null || echo 'unknown')"
KERNEL="$(uname -r)"
UPTIME="$(uptime -p 2>/dev/null || echo 'unknown')"
LOAD="$(awk '{print $1, $2, $3}' /proc/loadavg 2>/dev/null || echo 'unknown')"
MEM_USED="$(free -h 2>/dev/null | awk '/Mem:/{print $3"/"$2}' || echo 'unknown')"
DISK_USED="$(df -h / 2>/dev/null | awk 'NR==2{print $3"/"$2" ("$5")"}' || echo 'unknown')"

echo -e "  ${GREEN}Version:${NC}   ${VERSION}"
echo -e "  ${GREEN}Kernel:${NC}    ${KERNEL}"
echo -e "  ${GREEN}Uptime:${NC}    ${UPTIME}"
echo -e "  ${GREEN}Load:${NC}      ${LOAD}"
echo -e "  ${GREEN}Memory:${NC}    ${MEM_USED}"
echo -e "  ${GREEN}Disk:${NC}      ${DISK_USED}"

# GPU info (if available)
if command -v nvidia-smi &>/dev/null && nvidia-smi &>/dev/null; then
    GPU_NAME="$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1)"
    GPU_TEMP="$(nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader 2>/dev/null | head -1)"
    echo -e "  ${GREEN}GPU:${NC}       ${GPU_NAME} (${GPU_TEMP}°C)"
fi

# Service status summary
ACTIVE=0
TOTAL=0
for svc in opcua-server modbus-adapter mqtt-adapter siemens-s7-adapter bacnet-adapter rest-bridge-adapter; do
    if systemctl is-enabled --quiet "${svc}" 2>/dev/null; then
        ((TOTAL++))
        systemctl is-active --quiet "${svc}" 2>/dev/null && ((ACTIVE++))
    fi
done
if [[ ${TOTAL} -gt 0 ]]; then
    echo -e "  ${GREEN}Services:${NC}  ${ACTIVE}/${TOTAL} active"
fi

echo ""
echo -e "  ${DIM}Commands: amitos-info │ amitos-check │ amitos-adapter${NC}"
echo ""
