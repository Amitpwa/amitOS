# ============================================================================
# amitOS — Modbus Adapter Service
# ============================================================================

[Unit]
Description=amitOS Modbus Adapter (TCP/RTU)
Documentation=https://github.com/Amitpwa/amitOS/blob/dev/docs/ADAPTERS.md
After=network-online.target opcua-server.service
Wants=network-online.target
PartOf=amitos-adapters.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/opt/amitos/adapters/venv/bin/python3 -m amitos.adapters.modbus --config /etc/amitos/adapters/modbus.yaml
Restart=on-failure
RestartSec=5
WorkingDirectory=/opt/amitos/adapters

# Resource limits
LimitNOFILE=8192

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/log/amitos
ConfigurationDirectory=amitos/adapters

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=modbus-adapter

[Install]
WantedBy=amitos-adapters.target multi-user.target
